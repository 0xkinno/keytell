# Keytell app environment. Copy to .env.local; nothing here is secret and none of it is required.
# Public URL used in wallet branding and links (defaults to https://keytell.vercel.app).
NEXT_PUBLIC_APP_URL=
# Designed degraded states for demos and tests: stale_bq | intents_down | rpc_down (empty = normal).
KEYTELL_FAULT=
